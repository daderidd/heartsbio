---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Partners from '../components/sections/Partners.astro';
import Technology from '../components/sections/Technology.astro';
import FitazimSpotlight from '../components/sections/FitazimSpotlight.astro';
import FlagshipComparison from '../components/sections/FlagshipComparison.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import Stats from '../components/sections/Stats.astro';
import Team from '../components/sections/Team.astro';
import Contact from '../components/sections/Contact.astro';
import { getLang } from '../i18n';

// Also rendered at /nl/ (see src/pages/nl/index.astro).
const title = {
  en: 'HeartsBio — Enzyme & Microbial Solutions for Sustainable Agriculture | heartsbio.nl',
  nl: 'HeartsBio | Enzym- en microbiële oplossingen voor duurzame landbouw',
}[getLang(Astro.url)];
---

<BaseLayout title={title}>
  <Hero />
  <Problem />
  <Partners />
  <Technology />
  <FitazimSpotlight />
  <FlagshipComparison />
  <Portfolio />
  <Stats />
  <!-- Team section hidden until Rafael provides full exec bios -->
  <!-- <Team /> -->
  <Contact />
</BaseLayout>
