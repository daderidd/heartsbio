---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLang, localizePath, locales } from '../i18n';

// Also rendered at /nl/terms/ (see src/pages/nl/terms.astro).
const lang = getLang(Astro.url);
const meta = {
  en: {
    title: 'Terms of Service - HeartsBio',
    description: 'Terms of Service for HeartsBio website',
    badge: 'LEGAL',
    heading: 'Terms of Service',
    updated: 'Last updated',
    back: 'Back to Home',
  },
  nl: {
    title: 'Gebruiksvoorwaarden | HeartsBio',
    description: 'Gebruiksvoorwaarden van de website van HeartsBio',
    badge: 'JURIDISCH',
    heading: 'Gebruiksvoorwaarden',
    updated: 'Laatst bijgewerkt',
    back: 'Terug naar de homepage',
  },
}[lang];

const updatedDate = new Date().toLocaleDateString(locales[lang], { year: 'numeric', month: 'long', day: 'numeric' });

const h2 = 'text-2xl font-display font-bold text-black dark:text-white mb-4';
const p = 'text-black/70 dark:text-white/60';
const ul = 'list-disc pl-6 space-y-2 text-black/70 dark:text-white/60';
const link = 'text-dark-green dark:text-cream hover:underline';
---

<BaseLayout title={meta.title} description={meta.description}>
  <div class="min-h-screen bg-cream dark:bg-[#1a1a1a] py-20">
    <div class="container-custom max-w-4xl">
      <div class="bg-white dark:bg-[#111] rounded-3xl p-8 md:p-12 shadow-sm">
        <!-- Header -->
        <div class="mb-8">
          <div class="inline-block mb-4 px-4 py-2 bg-dark-green/10 dark:bg-white/10 rounded-full">
            <span class="text-dark-green dark:text-cream font-semibold text-sm tracking-wide">{meta.badge}</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-display font-bold text-black dark:text-white mb-4">
            {meta.heading}
          </h1>
          <p class="text-lg text-black/70 dark:text-white/60">
            {meta.updated}: {updatedDate}
          </p>
        </div>

        <!-- Content -->
        <div class="prose prose-lg max-w-none">
          {lang === 'nl' ? (
            <Fragment>
              <h2 class={h2}>Gebruik van de website</h2>
              <p class:list={[p, 'mb-6']}>
                Deze website is bedoeld om informatie te geven over de onderzoeks- en ontwikkelingsactiviteiten van HeartsBio op het gebied van biotechnologie. Door deze website te gebruiken, gaat u ermee akkoord dat u:
              </p>
              <ul class:list={[ul, 'mb-8']}>
                <li>de website gebruikt in overeenstemming met de geldende wet- en regelgeving</li>
                <li>de website niet gebruikt voor onrechtmatige of verboden doeleinden</li>
                <li>de intellectuele eigendomsrechten van HeartsBio respecteert</li>
                <li>niet probeert zich onbevoegd toegang te verschaffen tot enig deel van de website</li>
              </ul>

              <h2 class={h2}>Intellectueel eigendom</h2>
              <p class:list={[p, 'mb-8']}>
                Alle inhoud van deze website, waaronder teksten, grafisch materiaal, logo's en afbeeldingen, is eigendom van HeartsBio en wordt beschermd door het Nederlandse en internationale auteursrecht.
              </p>

              <h2 class={h2}>Beperking van aansprakelijkheid</h2>
              <p class:list={[p, 'mb-8']}>
                Hoewel wij ernaar streven dat de informatie op deze website juist en actueel is, geeft HeartsBio geen enkele garantie of toezegging met betrekking tot de website of de inhoud ervan.
              </p>

              <h2 class={h2}>Toepasselijk recht</h2>
              <p class:list={[p, 'mb-8']}>
                Op deze voorwaarden en op uw gebruik van deze website is Nederlands recht van toepassing.
              </p>

              <h2 class={h2}>Contact</h2>
              <p class:list={[p, 'mb-4']}>
                Heeft u vragen over deze voorwaarden? Neem dan contact met ons op:
              </p>
              <div class="bg-cream dark:bg-[#1a1a1a] rounded-xl p-6">
                <p class:list={[p, 'mb-2']}>
                  <strong>E-mail:</strong> <a href="mailto:info@heartsbio.nl" class={link}>info@heartsbio.nl</a>
                </p>
                <p class={p}>
                  <strong>Vestiging:</strong> Nederland
                </p>
              </div>
            </Fragment>
          ) : (
            <Fragment>
              <h2 class={h2}>Website Use</h2>
              <p class:list={[p, 'mb-6']}>
                This website is provided for informational purposes about HeartsBio's biotechnology research and development services. By using this website, you agree to:
              </p>
              <ul class:list={[ul, 'mb-8']}>
                <li>Use the website in compliance with applicable laws and regulations</li>
                <li>Not use the website for any unlawful or prohibited purposes</li>
                <li>Respect intellectual property rights of HeartsBio</li>
                <li>Not attempt to gain unauthorized access to any part of the website</li>
              </ul>

              <h2 class={h2}>Intellectual Property</h2>
              <p class:list={[p, 'mb-8']}>
                All content on this website, including text, graphics, logos, and images, is the property of HeartsBio and is protected by Dutch and international copyright laws.
              </p>

              <h2 class={h2}>Limitation of Liability</h2>
              <p class:list={[p, 'mb-8']}>
                While we strive to ensure the information on this website is accurate and up-to-date, HeartsBio makes no representations or warranties of any kind regarding the website or its content.
              </p>

              <h2 class={h2}>Governing Law</h2>
              <p class:list={[p, 'mb-8']}>
                These terms and your use of this website are governed by the laws of the Netherlands.
              </p>

              <h2 class={h2}>Contact Us</h2>
              <p class:list={[p, 'mb-4']}>
                If you have any questions about these terms, please contact us:
              </p>
              <div class="bg-cream dark:bg-[#1a1a1a] rounded-xl p-6">
                <p class:list={[p, 'mb-2']}>
                  <strong>Email:</strong> <a href="mailto:info@heartsbio.nl" class={link}>info@heartsbio.nl</a>
                </p>
                <p class={p}>
                  <strong>Location:</strong> The Netherlands
                </p>
              </div>
            </Fragment>
          )}
        </div>

        <!-- Back Link -->
        <div class="mt-12 pt-8 border-t border-black/10 dark:border-white/10">
          <a href={localizePath('/', lang)} class="inline-flex items-center gap-2 text-dark-green dark:text-cream hover:text-green transition-colors font-semibold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            {meta.back}
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
