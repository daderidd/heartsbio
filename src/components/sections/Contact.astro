---
// Contact Section - Get in touch form
// Both language versions post to the same Netlify form ("contact") with identical fields.
import { getLang, localizePath } from '../../i18n';

const lang = getLang(Astro.url);
const copy = {
  en: {
    tag: 'Connect',
    title: 'Get in touch',
    intro: "Whether you're an investor, distributor, or researcher — we'd like to hear from you.",
    response: 'We typically respond within 2 business days.',
    emailLabel: 'Email info@heartsbio.nl',
    formLabel: 'Contact form',
    honeypot: "Don't fill this out:",
    firstName: 'First name',
    lastName: 'Last name',
    email: 'Email',
    message: 'Message',
    placeholder: 'Type your message...',
    consentA: 'I consent to the processing of my personal data as described in the',
    consentLink: 'Privacy Policy',
    consentB: '. This information will only be used to respond to my inquiry.',
    required: 'Required field',
    send: 'Send',
    sendLabel: 'Send message',
  },
  nl: {
    tag: 'Contact',
    title: 'Neem contact op',
    intro: 'Bent u investeerder, distributeur of onderzoeker? We horen graag van u.',
    response: 'We reageren meestal binnen 2 werkdagen.',
    emailLabel: 'Mail naar info@heartsbio.nl',
    formLabel: 'Contactformulier',
    honeypot: 'Niet invullen:',
    firstName: 'Voornaam',
    lastName: 'Achternaam',
    email: 'E-mailadres',
    message: 'Bericht',
    placeholder: 'Typ hier uw bericht...',
    consentA: 'Ik geef toestemming voor de verwerking van mijn persoonsgegevens zoals beschreven in de',
    consentLink: 'privacyverklaring',
    consentB: '. Deze gegevens worden alleen gebruikt om op mijn vraag te reageren.',
    required: 'Verplicht veld',
    send: 'Versturen',
    sendLabel: 'Bericht versturen',
  },
};
const t = copy[lang];
---

<section id="contact" class="section bg-cream dark:bg-[#1a1a1a]">
  <div class="container-custom">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Contact Info Card -->
      <div class="bg-white dark:bg-[#111] rounded-3xl p-10 lg:p-12 shadow-sm reveal-left">
        <!-- Tag -->
        <div class="flex items-center gap-2 mb-6">
          <div class="w-8 h-1 bg-dark-green dark:bg-cream rounded-full"></div>
          <span class="text-dark-green dark:text-cream font-semibold text-sm tracking-widest uppercase">{t.tag}</span>
        </div>

        <!-- Heading -->
        <h2 class="text-4xl lg:text-5xl font-display font-bold text-black dark:text-white mb-4">
          {t.title}
        </h2>

        <p class="text-black/70 dark:text-white/60 text-lg mb-3">
          {t.intro}
        </p>
        <p class="text-black/40 dark:text-white/30 text-sm mb-10">
          {t.response}
        </p>

        <!-- Contact Details -->
        <div class="space-y-6">
          <!-- Email -->
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-cream dark:bg-[#1a1a1a] flex items-center justify-center flex-shrink-0" aria-hidden="true">
              <svg class="w-5 h-5 text-dark-green dark:text-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <a href="mailto:info@heartsbio.nl" class="text-black dark:text-white hover:text-green transition-colors text-lg" aria-label={t.emailLabel}>
              info@heartsbio.nl
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Contact Form -->
      <div class="reveal-right">
        <form name="contact" class="space-y-6" method="POST" data-netlify="true" netlify-honeypot="bot-field" aria-label={t.formLabel}>
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>{t.honeypot} <input name="bot-field" /></label>
          </p>
          <!-- Name Row -->
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="first-name" class="block text-black/70 dark:text-white/60 text-sm mb-2">{t.firstName}</label>
              <input
                type="text"
                id="first-name"
                name="firstName"
                required
                aria-required="true"
                class="w-full px-4 py-3 bg-white dark:bg-[#222] border border-black/10 dark:border-white/10 rounded-lg focus:outline-none focus:ring-2 focus:ring-dark-green focus:border-transparent transition-all dark:text-white"
              />
            </div>
            <div>
              <label for="last-name" class="block text-black/70 dark:text-white/60 text-sm mb-2">{t.lastName}</label>
              <input
                type="text"
                id="last-name"
                name="lastName"
                required
                aria-required="true"
                class="w-full px-4 py-3 bg-white dark:bg-[#222] border border-black/10 dark:border-white/10 rounded-lg focus:outline-none focus:ring-2 focus:ring-dark-green focus:border-transparent transition-all dark:text-white"
              />
            </div>
          </div>

          <!-- Email Row -->
          <div>
            <label for="email" class="block text-black/70 dark:text-white/60 text-sm mb-2">{t.email}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              aria-required="true"
              class="w-full px-4 py-3 bg-white dark:bg-[#222] border border-black/10 dark:border-white/10 rounded-lg focus:outline-none focus:ring-2 focus:ring-dark-green focus:border-transparent transition-all dark:text-white"
            />
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-black/70 dark:text-white/60 text-sm mb-2">{t.message}</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              aria-required="true"
              placeholder={t.placeholder}
              class="w-full px-4 py-3 bg-white dark:bg-[#222] border border-black/10 dark:border-white/10 rounded-lg focus:outline-none focus:ring-2 focus:ring-dark-green focus:border-transparent transition-all resize-none dark:text-white"
            ></textarea>
          </div>

          <!-- Privacy Policy Consent (GDPR Required) -->
          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="privacy-consent"
              name="privacyConsent"
              required
              aria-required="true"
              class="mt-1 w-4 h-4 text-dark-green bg-white dark:bg-[#222] border-black/20 dark:border-white/10 rounded focus:ring-2 focus:ring-dark-green cursor-pointer"
            />
            <label for="privacy-consent" class="text-sm text-black/70 dark:text-white/60 leading-relaxed cursor-pointer">
              {t.consentA}{' '}
              <a href={localizePath('/privacy', lang)} class="text-dark-green dark:text-cream hover:underline font-medium" target="_blank" rel="noopener noreferrer">{t.consentLink}</a>{t.consentB} <span class="text-red-600" aria-label={t.required}>*</span>
            </label>
          </div>

          <!-- Submit Button -->
          <div>
            <button
              type="submit"
              class="px-10 py-4 bg-black text-white rounded-full font-semibold hover:bg-dark-green hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 text-lg disabled:opacity-50 disabled:cursor-not-allowed"
              aria-label={t.sendLabel}
            >
              {t.send}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
