---
// Products Section - Showcase our biological solutions
import { Image } from 'astro:assets';
import { getLang, localizePath } from '../../i18n';
import leavesBg from '../../assets/images/products/leaves-bg.webp';
import enhancedFertilizer from '../../assets/images/R&D portfolio/enhanced-fertilizer.webp';
import climateStress from '../../assets/images/R&D portfolio/climate-stress-alleviator.webp';
import seedCoating from '../../assets/images/R&D portfolio/seed-coating.webp';

const lang = getLang(Astro.url);
const copy = {
  en: {
    badge: 'PRODUCT PORTFOLIO',
    title: 'Four Products, One Mission',
    intro: 'Each product targets a different stage of the agricultural cycle — from soil preparation to seed to harvest.',
    learnMore: 'Learn more',
    learnMoreAbout: (name: string) => `Learn more about ${name}`,
    viewAll: 'Explore all products in detail',
    products: {
      fitazim: { title: 'Proven Phosphorus Booster', category: 'Phosphate Uptake Solutions' },
      'bio-dop': { title: 'Enzymatic Fertilizer Coating', category: 'Phosphate Uptake Solutions' },
      purisol: { title: 'Living Soil Microbiome', category: 'Biological Soil Amendment', certification: 'Ecocert Certified' },
      'sg-2': { title: 'Enzymatic Seed Coating', category: 'Seed Coating' },
    },
  },
  nl: {
    badge: 'PRODUCTPORTFOLIO',
    title: 'Vier producten, één missie',
    intro: 'Elk product richt zich op een andere fase van de teelt: van bodemvoorbereiding en zaad tot oogst.',
    learnMore: 'Meer informatie',
    learnMoreAbout: (name: string) => `Meer over ${name}`,
    viewAll: 'Bekijk alle producten in detail',
    products: {
      fitazim: { title: 'Bewezen fosforbooster', category: 'Fosfaatopname' },
      'bio-dop': { title: 'Enzymatische kunstmestcoating', category: 'Fosfaatopname' },
      purisol: { title: 'Levend bodemmicrobioom', category: 'Biologische bodemverbeteraar', certification: 'Ecocert-gecertificeerd' },
      'sg-2': { title: 'Enzymatische zaadcoating', category: 'Zaadcoating' },
    },
  },
};
const t = copy[lang];

// Only the fields shown on the card; full product copy lives on /products.
const products = [
  { id: 'fitazim', name: 'Fitazim', image: leavesBg },
  { id: 'bio-dop', name: 'Bio-Dop', image: enhancedFertilizer },
  { id: 'purisol', name: 'Purisol', image: climateStress },
  { id: 'sg-2', name: 'SG-2', image: seedCoating },
].map((p) => ({ ...p, ...t.products[p.id as keyof typeof t.products] })) as {
  id: string; name: string; image: ImageMetadata; title: string; category: string; certification?: string;
}[];
---

<section id="portfolio" class="section bg-white dark:bg-[#111]">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 reveal">
      <div class="inline-block mb-4 px-4 py-2 bg-green/10 dark:bg-white/10 rounded-full">
        <span class="text-dark-green dark:text-cream font-semibold text-sm tracking-wide">{t.badge}</span>
      </div>
      <h2 class="text-black dark:text-white mb-4">
        {t.title}
      </h2>
      <p class="text-lg text-black/50 dark:text-white/50">
        {t.intro}
      </p>
    </div>

    <!-- Compact Products Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {products.map((product, index) => (
        <a
          href={localizePath(`/products#${product.id}`, lang)}
          class={`group relative rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-500 hover:-translate-y-2 cursor-pointer block reveal stagger-${index + 1}`}
          aria-label={t.learnMoreAbout(product.name)}
        >
          <div class="aspect-[3/4] overflow-hidden">
            <Image
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
              width={700}
              height={933}
              quality={85}
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-dark-green/90 via-dark-green/30 to-transparent"></div>

          {product.certification && (
            <div class="absolute top-3 right-3">
              <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-white/90 backdrop-blur-sm text-dark-green text-xs font-semibold rounded-full">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                {product.certification}
              </span>
            </div>
          )}

          <div class="absolute bottom-0 left-0 right-0 p-5">
            <div class="text-[10px] uppercase tracking-wider text-white/50 font-semibold mb-1">{product.category}</div>
            <h3 class="text-xl font-display font-bold text-white mb-1">{product.name}</h3>
            <p class="text-sm text-white/70 leading-snug mb-3">{product.title}</p>
            <div class="flex items-center gap-1.5 text-cream text-sm font-semibold group-hover:gap-2.5 transition-all">
              <span>{t.learnMore}</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- View All CTA -->
    <div class="text-center mt-12">
      <a
        href={localizePath('/products', lang)}
        class="inline-flex items-center gap-2 text-dark-green dark:text-cream font-semibold hover:gap-3 transition-all group"
      >
        <span>{t.viewAll}</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
