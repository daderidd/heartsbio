---
// Fitazim Spotlight — Homepage flagship product section
import { Image } from 'astro:assets';
import FitazimVisualization from '../FitazimVisualization';
import fitazimTrial1 from '../../assets/images/products/Fitazim Trial 1.webp';
import fitazimTrial2 from '../../assets/images/products/Fitazim Trial 1-2.webp';
import { getLang, localizePath } from '../../i18n';

const lang = getLang(Astro.url);
const copy = {
  en: {
    badge: 'FLAGSHIP PRODUCT',
    title: 'Meet Fitazim',
    intro: 'Our proprietary enzyme formulation that unlocks bound phosphorus from the soil — turning a wasted resource into plant nutrition.',
    videoTitle: 'Fitazim — Enzyme technology for phosphorus recovery in agriculture',
    evidenceBadge: 'VISUAL EVIDENCE',
    evidenceSub: 'Side-by-side comparison under identical soil conditions',
    controlAlt: 'Control plants without Fitazim',
    controlLabel: 'Control (untreated)',
    treatedAlt: 'Fitazim-treated plants showing improved growth',
    treatedLabel: 'Fitazim-treated',
    cta: 'Explore All Products',
  },
  nl: {
    badge: 'ONS VLAGGENSCHIP',
    title: 'Maak kennis met Fitazim',
    intro: 'Onze eigen enzymformulering ontsluit gebonden fosfor in de bodem en maakt zo van een verspilde grondstof plantenvoeding.',
    videoTitle: 'Fitazim: enzymtechnologie voor betere fosforbenutting in de landbouw',
    evidenceBadge: 'ZIE HET VERSCHIL',
    evidenceSub: 'Directe vergelijking onder identieke bodemomstandigheden',
    controlAlt: 'Controleplanten zonder Fitazim',
    controlLabel: 'Controle (onbehandeld)',
    treatedAlt: 'Met Fitazim behandelde planten met betere groei',
    treatedLabel: 'Behandeld met Fitazim',
    cta: 'Bekijk alle producten',
  },
};
const t = copy[lang];
---

<section id="fitazim" class="section bg-cream dark:bg-[#1a1a1a] overflow-hidden">
  <div class="container-custom">
    <!-- Header -->
    <div class="max-w-4xl mx-auto text-center mb-14 reveal">
      <div class="inline-block mb-4 px-4 py-2 bg-dark-green/8 dark:bg-white/10 rounded-full">
        <span class="text-dark-green dark:text-cream font-semibold text-sm tracking-wide">{t.badge}</span>
      </div>
      <h2 class="text-black dark:text-white mb-4">
        {t.title}
      </h2>
      <p class="text-lg text-black/50 dark:text-white/60 max-w-2xl mx-auto">
        {t.intro}
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <!-- 1. Video (the hook) -->
      <div class="reveal-scale mb-16">
        <div class="aspect-video rounded-2xl overflow-hidden shadow-xl">
          <iframe
            src="https://www.youtube.com/embed/VwBWE6A5JGE?rel=0"
            title={t.videoTitle}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="w-full h-full"
          ></iframe>
        </div>
      </div>

      <!-- 2. Interactive storytelling visualization (the data) -->
      <div class="reveal-scale mb-16">
        <FitazimVisualization client:visible lang={lang} />
      </div>

      <!-- 3. Trial comparison photos (visual proof) -->
      <div class="text-center mb-8 reveal">
        <div class="inline-block mb-3 px-4 py-2 bg-dark-green/8 dark:bg-white/10 rounded-full">
          <span class="text-dark-green dark:text-cream font-semibold text-sm tracking-wide">{t.evidenceBadge}</span>
        </div>
        <p class="text-black/40 dark:text-white/40 text-sm max-w-lg mx-auto">
          {t.evidenceSub}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5 mb-12">
        <div class="reveal-left group relative rounded-2xl overflow-hidden shadow-lg">
          <div class="aspect-[4/3] overflow-hidden">
            <Image
              src={fitazimTrial1}
              alt={t.controlAlt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={1072}
              height={628}
              quality={90}
            />
          </div>
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-4">
            <span class="text-white text-sm font-semibold">{t.controlLabel}</span>
          </div>
        </div>
        <div class="reveal-right group relative rounded-2xl overflow-hidden shadow-lg">
          <div class="aspect-[4/3] overflow-hidden">
            <Image
              src={fitazimTrial2}
              alt={t.treatedAlt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={1224}
              height={898}
              quality={90}
            />
          </div>
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-dark-green/70 to-transparent p-4">
            <span class="text-white text-sm font-semibold">{t.treatedLabel}</span>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center reveal">
        <a
          href={localizePath('/products#fitazim', lang)}
          class="inline-flex items-center gap-2 px-8 py-4 bg-dark-green text-white font-semibold rounded-full hover:bg-green hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 shadow-lg group"
        >
          {t.cta}
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
